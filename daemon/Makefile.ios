# legacyrayd and its helpers for armv7, ios 4-7, against static openssl.
# static linkage keeps the runtime dependency limited to libsystem.
include ../make/config.mk

ifeq ($(wildcard $(LR_OSSL)/lib/libcrypto.a),)
$(error no armv7 openssl at $(LR_OSSL): run scripts/build_deps.sh first)
endif

BUILD   ?= build/ios
CFLAGS  := -std=c99 -Wall -Wextra -Wno-unused-parameter -O2 -DSENKO_RELEASE \
           $(LR_ARCH) $(LR_SYSROOT) -include legacy_compat.h \
           -Icore -Icore/third_party -I. -I$(LR_OSSL)/include
LIBS    := $(LR_OSSL)/lib/libssl.a $(LR_OSSL)/lib/libcrypto.a -lz
LDFLAGS := $(LR_ARCH) $(LR_SYSROOT) -Wl,-dead_strip

CORE_SRC = core/vless.c core/b64.c core/config.c core/rules.c core/dns_msg.c core/doh.c \
           core/dns_cache.c core/profiles.c core/happ.c core/happ_crypt5.c \
           core/third_party/cJSON.c core/net_safe.c core/socks5.c core/senko_trace.c \
           core/senko_replay.c core/senko_upload.c core/vless_conn.c core/session.c \
           core/store.c core/control.c core/ctl_engine.c core/http.c core/url.c \
           core/subfetch.c core/transport_tcp.c core/transport_tls.c core/frag.c core/geo.c core/transport_ws.c \
           core/transport_xhttp.c core/transport_pick.c core/grpc_core.c core/h2_core.c \
           core/hpack.c core/reality_crypto.c core/reality_auth.c core/tls_clienthello.c \
           core/tls13_kdf.c core/tls13_keysched.c core/tls13_record.c \
           core/tls13_transcript.c core/tls13_handshake.c core/reality_handshake.c \
           core/socks5_client.c core/http_client.c core/vision.c core/awg_config.c \
           core/awg_handshake.c core/trojan_client.c core/shadowsocks_client.c core/vmess_client.c \
           core/blake2b256.c
# vendored PQClean ml-kem-768 "clean" backend, plus its shared fips202.c and a
# local randombytes.c shim over the core's openssl rng; see core/third_party/mlkem768/LICENSE
MLKEM768_SRC = core/third_party/mlkem768/kem.c core/third_party/mlkem768/indcpa.c \
               core/third_party/mlkem768/poly.c core/third_party/mlkem768/polyvec.c \
               core/third_party/mlkem768/ntt.c core/third_party/mlkem768/cbd.c \
               core/third_party/mlkem768/reduce.c core/third_party/mlkem768/verify.c \
               core/third_party/mlkem768/symmetric-shake.c core/third_party/mlkem768/fips202.c \
               core/third_party/mlkem768/randombytes.c
CORE_SRC += $(MLKEM768_SRC)
DAEMON_SRC = dialer.c loop.c core/sniff.c pf_natlook.c ctl_server.c daemon_ctl.c storefile.c netwatch.c geo_ctl.c \
             settings.c status.c routing.c routing_exec.c routing_fwd.c pf_table.c \
             c_backend.c go_config.c go_backend.c engine_config.c engine_backend.c awg_utun.c awg_route.c awg_pfroute.c \
             legacy_ios.c proc_detach.c main.c
AWGD_SRC   = senkoawgd.c awg_utun.c awg_route.c awg_pfroute.c core/awg_config.c \
             core/awg_handshake.c core/awg_tunnel.c core/b64.c core/reality_crypto.c \
             $(MLKEM768_SRC) status.c legacy_ios.c proc_detach.c

TOOLS = $(BUILD)/legacyrayd $(BUILD)/legacyrayctl $(BUILD)/legacyray-kick $(BUILD)/legacyrayawgd \
        $(BUILD)/legacyray-ssh

.PHONY: all clean
all: $(TOOLS)

$(BUILD)/legacyrayd: $(CORE_SRC) $(DAEMON_SRC) legacy_compat.h
	@mkdir -p $(BUILD)
	$(LR_CC) $(CFLAGS) $(CORE_SRC) $(DAEMON_SRC) -o $@ $(LDFLAGS) $(LIBS)
	$(LR_STRIP) -x $@
	$(LR_LDID) -S $@

# legacyrayctl decodes the plain control protocol and fetch payloads
$(BUILD)/legacyrayctl: senkoctl.c core/b64.c legacy_compat.h
	@mkdir -p $(BUILD)
	$(LR_CC) $(CFLAGS) senkoctl.c core/b64.c -o $@ $(LDFLAGS)
	$(LR_STRIP) -x $@
	$(LR_LDID) -S $@

$(BUILD)/legacyrayawgd: $(AWGD_SRC) legacy_compat.h
	@mkdir -p $(BUILD)
	$(LR_CC) $(CFLAGS) $(AWGD_SRC) -o $@ $(LDFLAGS) $(LIBS)
	$(LR_STRIP) -x $@
	$(LR_LDID) -S $@

# legacyray-ssh: the app's ssh client for setting up its user's own server.
# runs as mobile; libssh2 on the same static openssl
$(BUILD)/legacyray-ssh: lr_ssh.c core/b64.c legacy_compat.h
	@mkdir -p $(BUILD)
	$(LR_CC) $(CFLAGS) -I$(LR_SSH2)/include lr_ssh.c core/b64.c -o $@ $(LDFLAGS) \
	    $(LR_SSH2)/lib/libssh2.a $(LR_OSSL)/lib/libcrypto.a
	$(LR_STRIP) -x $@
	$(LR_LDID) -S $@

# setuid root kick: the mobile app restarts the launchd job without a reboot.
# it carries the app entitlements so a strict jailbreak sandbox lets it run
$(BUILD)/legacyray-kick: senko_kick.c legacy_compat.h
	@mkdir -p $(BUILD)
	$(LR_CC) $(CFLAGS) senko_kick.c -o $@ $(LDFLAGS)
	$(LR_STRIP) -x $@
	$(LR_LDID) -S../app/Resources/entitlements.plist $@

clean:
	rm -rf build/ios
