#!/bin/sh
# LegacyRay postinst for rootful jailbreaks on ios 4-7. every optional step
# ends in "|| true": a missing tool must never leave dpkg half-configured.

PLIST=/Library/LaunchDaemons/com.legacyray.daemon.plist
APP=/Applications/LegacyRay.app
KICK=/usr/bin/legacyray-kick
SUBSTRATE_DIR=/Library/MobileSubstrate/DynamicLibraries
CFG=/var/root/Library/Preferences/legacyray.cfg
PREFS=/var/mobile/Library/Preferences
STATUS_STATE=$PREFS/com.legacyray.status.state
LAUNCHCTL=/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/usr/bin/launchctl

for bin in /usr/bin/legacyrayd /usr/bin/legacyrayctl /usr/bin/legacyrayawgd /usr/bin/legacyray-ssh \
           /usr/lib/legacyray-engine; do
  [ -e "$bin" ] && chown root:wheel "$bin" && chmod 755 "$bin" || true
done
# the app runs as mobile and cannot signal the root daemon itself; the kick
# helper is setuid root. a filesystem mounted nosuid is the one failure that
# leaves dpkg happy and the app unable to start its daemon, so say so
if [ -e "$KICK" ]; then
  chown root:wheel "$KICK" || true
  chmod 4755 "$KICK" || true
  if [ ! -u "$KICK" ]; then
    echo "legacyray-kick: setuid bit did not stick (nosuid mount?)" >> /var/log/legacyray-kick.log 2>/dev/null || true
  fi
fi
chown root:wheel "$PLIST" 2>/dev/null || true
chmod 644 "$PLIST" 2>/dev/null || true
chown -R root:wheel /usr/lib/legacyraytlsfix 2>/dev/null || true
chmod 755 /usr/lib/legacyraytlsfix.dylib /usr/lib/legacyraystatus.dylib 2>/dev/null || true

# mobilesubstrate hooks, only where substrate exists. the tls hook stays off
# when the standalone tlsfix tweak is installed: both would patch the same
# functions
if [ -e /Library/MobileSubstrate/MobileSubstrate.dylib ]; then
  mkdir -p "$SUBSTRATE_DIR" || true
  if dpkg -s com.tlsfix >/dev/null 2>&1 || [ -e "$SUBSTRATE_DIR/tlsfix.dylib" ]; then
    rm -f "$SUBSTRATE_DIR/legacyraytlsfix.dylib" "$SUBSTRATE_DIR/legacyraytlsfix.plist"
  else
    ln -sf /usr/lib/legacyraytlsfix.dylib "$SUBSTRATE_DIR/legacyraytlsfix.dylib" || true
    cp /usr/lib/legacyraytlsfix/substrate-filter.plist "$SUBSTRATE_DIR/legacyraytlsfix.plist" || true
  fi
  ln -sf /usr/lib/legacyraystatus.dylib "$SUBSTRATE_DIR/legacyraystatus.dylib" || true
  cp /usr/lib/legacyraystatus.plist "$SUBSTRATE_DIR/legacyraystatus.plist" || true
  chmod 644 "$SUBSTRATE_DIR"/legacyray*.plist 2>/dev/null || true
fi

# pfctl wants an os fingerprint file some jailbreaks do not ship
[ -e /etc/pf.os ] || ln -s /usr/share/legacyray/pf.os /etc/pf.os 2>/dev/null || true

mkdir -p "$PREFS/LegacyRay" /var/root/Library/Preferences || true
chown mobile:mobile "$PREFS/LegacyRay" 2>/dev/null || true
printf '0\n' > "$STATUS_STATE" 2>/dev/null || true
chown mobile:mobile "$STATUS_STATE" "$PREFS/com.legacyray.tlsfix.plist" 2>/dev/null || true
chmod 644 "$STATUS_STATE" "$PREFS/com.legacyray.tlsfix.plist" 2>/dev/null || true
for log in /var/log/legacyray-system.log /var/log/legacyraytlsfix.log /tmp/legacyray-update.log; do
  touch "$log" 2>/dev/null || true
  chown root:mobile "$log" 2>/dev/null || true
  chmod 660 "$log" 2>/dev/null || true
done

if [ ! -s "$CFG" ]; then
  cat > "$CFG" <<'CFGEOF'
V1
SET socks_port 11080
SET socks_public 0
SET dns_upstream 8.8.8.8
SET dns_local_port 10053
SEL -1
CFGEOF
fi
chown root:wheel "$CFG" 2>/dev/null || true
chmod 600 "$CFG" 2>/dev/null || true

if [ -d "$APP" ]; then
  chown -R root:wheel "$APP" 2>/dev/null || true
  chmod 755 "$APP" "$APP/LegacyRay" 2>/dev/null || true
fi

# launchd holds the job but launchctl cannot load it back. some ios 6
# jailbreaks never create /var/tmp/launchd: there "unload" still reaches
# launchd while "load" and "list <label>" do not, so unloading dropped the
# job until the next reboot. a killed daemon comes back by KeepAlive instead,
# from whatever binary is installed by then
keep_job() {
  "$LAUNCHCTL" list 2>/dev/null | grep -q -E '(^|[[:space:]])com\.legacyray\.daemon[[:space:]]*$' &&
    ! "$LAUNCHCTL" list com.legacyray.daemon >/dev/null 2>&1
}

# the in-app updater runs this script itself and restarts the daemon after
if [ "${SENKO_UPDATE:-0}" != "1" ]; then
  # a daemon the kick started without launchd has a supervisor that would
  # start it again behind launchd's back
  [ -x "$KICK" ] && "$KICK" --stop-supervisor >/dev/null 2>&1 || true
  KEEP_JOB=0
  keep_job && KEEP_JOB=1
  [ "$KEEP_JOB" = 1 ] || "$LAUNCHCTL" unload "$PLIST" >/dev/null 2>&1 || true
  killall -TERM legacyrayd >/dev/null 2>&1 || true
  sleep 1
  killall -9 legacyrayd >/dev/null 2>&1 || true
  # a kept job is already starting the new daemon, which puts back its own
  # socket and token
  if [ "$KEEP_JOB" != 1 ]; then
    rm -f /var/tmp/legacyrayd.sock /var/tmp/legacyrayd.token
    "$LAUNCHCTL" load -w "$PLIST" >/dev/null 2>&1 || "$LAUNCHCTL" load "$PLIST" >/dev/null 2>&1 || true
  fi
  # launchctl exits 0 even when it cannot reach launchd (some ios 6 jailbreaks
  # lose /var/tmp/launchd after boot), and then no daemon ran until the app was
  # opened. the kick starts one itself when launchd did not
  if [ -x "$KICK" ]; then
    ( sleep 5; killall -0 legacyrayd >/dev/null 2>&1 || "$KICK" >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
  fi
fi

echo "LegacyRay installed. Control socket: /var/tmp/legacyrayd.sock"

# the icon appears once uicache has rebuilt the cache springboard reads when it
# starts, and on an old phone that takes many seconds. a springboard restarted
# before then comes up without the icon, so the restart waits for uicache. all
# of it is backgrounded: ios 6 uicache can deadlock against the running old app
# and dpkg must not wait for that, hence the time limit. what happened goes to a
# log the next install overwrites
CACHE=/var/mobile/Library/Caches/com.apple.mobile.installation.plist
INSTALL_LOG=/var/log/legacyray-install.log
UICACHE_DONE=/var/log/legacyray-uicache.done

# 0: the cache lists the app, 1: it does not, 2: the cache cannot be read this
# way (no file, or not even safari is in it), so it says nothing either way
in_cache() {
  grep -q -F com.apple.mobilesafari "$CACHE" 2>/dev/null || return 2
  grep -q -F com.legacyray.app "$CACHE" 2>/dev/null
}

RESPRING=0
if [ "${SENKO_SKIP_RESPRING:-0}" != "1" ]; then
  in_cache
  WAS_IN_CACHE=$?
  # the status bar hook loads into springboard, so a fresh install restarts it.
  # so does a reinstall that finds the app missing from the cache: that is the
  # icon of an earlier install that never came up
  if [ -z "$2" ] || [ "$WAS_IN_CACHE" = 1 ]; then RESPRING=1; fi
fi

# builds before 1.0.1 shipped the icon prerendered, without the system's
# shine. springboard keeps the icons it has drawn in an image cache and does
# not redraw them when an app is only upgraded, so the old flat icon stayed
# after the system was asked to draw the gloss. dropping that cache (ios 4-6
# image cache files, the ios 7 IconsCache folder) and restarting springboard
# makes it draw the icon again, with the gloss
ICON_REDRAW=0
if [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.0.1 2>/dev/null; then
  ICON_REDRAW=1
  rm -f /var/mobile/Library/Caches/com.apple.springboard-imagecache-icons \
        /var/mobile/Library/Caches/com.apple.springboard-imagecache-icons.plist \
        /var/mobile/Library/Caches/com.apple.springboard-imagecache-smallicons \
        /var/mobile/Library/Caches/com.apple.springboard-imagecache-smallicons.plist \
        2>/dev/null || true
  rm -rf /var/mobile/Library/Caches/com.apple.IconsCache 2>/dev/null || true
  [ "${SENKO_SKIP_RESPRING:-0}" != "1" ] && RESPRING=1
fi

LOG_TO=/dev/null
true 2>/dev/null >"$INSTALL_LOG" && LOG_TO=$INSTALL_LOG
(
  trap '' HUP
  echo "postinst $1 ${2:-none} $(date)"
  [ "$ICON_REDRAW" = 1 ] && echo "springboard icon cache dropped for the system gloss"
  rm -f "$UICACHE_DONE"
  ( uicache 2>&1; echo $? > "$UICACHE_DONE" ) &
  waited=0
  while [ ! -s "$UICACHE_DONE" ] && [ "$waited" -lt 90 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if [ -s "$UICACHE_DONE" ]; then
    echo "uicache exit $(cat "$UICACHE_DONE") after ${waited}s"
  else
    echo "uicache still running after ${waited}s, killed"
    killall -9 uicache 2>&1
  fi
  rm -f "$UICACHE_DONE"
  in_cache
  case $? in
    0) echo "the cache lists com.legacyray.app" ;;
    1) echo "the cache does not list com.legacyray.app" ;;
    *) echo "the cache cannot be checked" ;;
  esac
  if [ "$RESPRING" = 1 ]; then
    echo "restarting springboard"
    sleep 1
    killall -9 SpringBoard 2>&1
  fi
) </dev/null >"$LOG_TO" 2>&1 &
exit 0
