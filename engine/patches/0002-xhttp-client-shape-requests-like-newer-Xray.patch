+/// Puts a packet-up payload where the profile wants it. Returns false when
+/// it belongs in the body, which the caller then sends as usual.
+pub fn place_payload(
+    config: &XhttpClientConfig,
+    request: &mut Request<()>,
+    payload: &[u8],
+) -> io::Result<bool> {
+    let cookie = match config.uplink_data_placement {
+        XhttpDataPlacement::Body | XhttpDataPlacement::Auto => return Ok(false),
+        XhttpDataPlacement::Header => false,
+        XhttpDataPlacement::Cookie => true,
+    };
+    let key = config
+        .uplink_data_key
+        .as_deref()
+        .filter(|key| !key.is_empty())
+        .unwrap_or(if cookie { "x_data" } else { "X-Data" });
+    let default = if cookie { (2048, 3072) } else { (3000, 4000) };
+    let (min, max) = config.uplink_chunk_size.bounds(default, false)?;
+    let range = (min.max(64), max.max(64));
+    let encoded = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(payload);
+    let mut rest = encoded.as_str();
+    let mut cookies = Vec::new();
+    let mut index = 0;
+    while !rest.is_empty() {
+        let size = (sample(range) as usize).min(rest.len());
+        let (chunk, tail) = rest.split_at(size);
+        rest = tail;
+        if cookie {
+            cookies.push(format!("{key}_{index}={chunk}"));
+        } else {
+            let name =
+                http::HeaderName::try_from(format!("{key}-{index}")).map_err(io::Error::other)?;
+            request.headers_mut().insert(
+                name,
+                http::HeaderValue::from_str(chunk).map_err(io::Error::other)?,
+            );
+        }
+        index += 1;
+    }
+    if !cookies.is_empty() {
+        let mut all = request
+            .headers()
+            .get(http::header::COOKIE)
+            .and_then(|value| value.to_str().ok())
+            .map(str::to_owned)
+            .unwrap_or_default();
+        for cookie in cookies {
+            if !all.is_empty() {
+                all.push_str("; ");
+            }
+            all.push_str(&cookie);
+        }
+        request.headers_mut().insert(
+            http::header::COOKIE,
+            http::HeaderValue::from_str(&all).map_err(io::Error::other)?,
+        );
+    }
+    Ok(true)
+}
