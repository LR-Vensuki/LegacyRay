+/// Where a client puts its session id or packet sequence number.
+#[derive(Debug, Clone, Copy, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum XhttpPlacement {
+    #[default]
+    Path,
+    Query,
+    Header,
+    Cookie,
+}
+
+/// Where packet-up carries its uplink data. Header and cookie placements
+/// base64url-encode it in numbered chunks, for fronts that refuse bodies.
+#[derive(Debug, Clone, Copy, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum XhttpDataPlacement {
+    #[default]
+    Body,
+    Auto,
+    Header,
+    Cookie,
+}
+
+impl XhttpDataPlacement {
+    pub fn in_body(self) -> bool {
+        matches!(self, Self::Body | Self::Auto)
+    }
+}
+
+/// Where the request padding goes when padding obfuscation is on.
+#[derive(Debug, Clone, Copy, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum XhttpPaddingPlacement {
+    #[default]
+    QueryInHeader,
+    Header,
+    Query,
+    Cookie,
+}
